# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-only UI bypass. Use the read-only sample workspace without signing in.
# This flag is accepted only by `next dev`; keep it disabled in production.
CLIPFACTORY_AUTH_DISABLED=false

# Convex app and Convex Auth
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
SITE_URL=http://localhost:3000
# Set these with `npx @convex-dev/auth`, not in this file.
JWT_PRIVATE_KEY=
JWKS=

# g0i.ai OpenAI-compatible API
G0I_PROVIDER=g0i.ai
G0I_API_KEY=
G0I_BASE_URL=
# Shared default model. Per-operation lists below take precedence.
G0I_MODEL=
# Ordered comma-separated fallback list used after an operation-specific model fails.
G0I_MODEL_FALLBACKS=
# Each operation accepts an ordered comma-separated list. The first model that returns valid JSON wins.
G0I_MODEL_ANALYSIS=
G0I_MODEL_HOOKS=
G0I_MODEL_TITLE=
G0I_MODEL_DESCRIPTION=
G0I_MODEL_SCORING=
G0I_TIMEOUT_MS=30000
G0I_MAX_RETRIES=2
G0I_TEMPERATURE=0.2
G0I_MAX_OUTPUT_TOKENS=6000
G0I_MAX_CANDIDATES=8
G0I_MAX_TRANSCRIPT_CHARS=12000
G0I_MAX_RAW_RESPONSE_CHARS=120000

# Stripe Billing. Prefer a restricted server key in deployed environments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_FORWARDING_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CREATOR_MONTHLY=

# Cloudflare R2 or another S3-compatible service
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Media worker control plane. CONVEX_SITE_URL, WORKER_SHARED_SECRET, and
# WORKER_CALLBACK_SECRET must match in the Convex and worker environments.
WORKER_SHARED_SECRET=
WORKER_CALLBACK_SECRET=
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_TIMEOUT_MS=900000
# Optional provider for normalized speaker-aware crop tracks. Rendering falls back safely when unset.
FACE_TRACKER_URL=
FACE_TRACKER_API_KEY=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YT_DLP_PATH=yt-dlp
WORKER_PORT=8788
WORKER_ID=
WORKER_MAX_PARALLEL=2
WORKER_POLL_MS=2000
WORKER_HEARTBEAT_MS=30000
WORKER_LEASE_MS=600000
WORKER_MAX_ATTEMPTS=3
WORKER_CALLBACK_MAX_ATTEMPTS=5
WORKER_CONTROL_TIMEOUT_MS=30000
# Optional safe version label exposed by GET /health.
RELEASE_SHA=
