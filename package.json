{
  "name": "clip-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:reliability",
    "test:unit": "node --import tsx --test test/clip-analysis.test.ts test/site-url.test.ts test/video-engine.test.ts",
    "test:reliability": "vitest run test/reliability.convex.test.ts test/vitest/worker-reliability.test.ts",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "worker:dev": "tsx worker/src/server.ts",
    "worker:check": "tsx worker/src/capability-check.ts",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@base-ui/react": "^1.8.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/workflow": "^0.4.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "convex": "^1.45.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
